NEXT_PUBLIC_SUPABASE_URL=your_supabase_project_url
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key
# Protege /api/cron/semaforo (sección 9). Vercel agrega automáticamente
# `Authorization: Bearer $CRON_SECRET` a sus propias invocaciones de cron cuando esta variable
# existe en el proyecto — sin ella, el endpoint queda sin autenticar.
CRON_SECRET=your_cron_secret
# Carpeta raíz del expediente digital (opcional). SCIDAI guarda en la base solo rutas RELATIVAS a
# esta carpeta; aquí va la raíz real: hoy la carpeta compartida, mañana el NAS o el servidor de la
# DTI (ej. \\NAS-DAI\SCIDAI). Cambiarla no obliga a tocar ningún registro.
SCIDAI_RUTA_BASE_EXPEDIENTES=
